<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <PackageId>Deskling.Windows.Companion</PackageId>
    <Description>The Windows half of a desk-companion app's shell, over Deskling.Companion.Shell and Deskling.Windows: the speaker (recorded clips and the system speech synthesizer), the chime, and (as 0.8 grows) the tray status item and glyph, the window manager, the hotkey, the notifier, the desktop character's window and the WinUI controls every companion draws the same. Code only: no XAML, no strings, no permission prompts.</Description>
    <!-- Restores and compiles on Linux and macOS too (code only, no XAML), like Deskling.Windows; the Windows App SDK's
         PRI step needs Windows, so CI builds it on windows-latest (dotnet.yml). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- CsWinRT's generated code for collections crossing the WinRT ABI, and Win32 structs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <ProjectReference Include="../Deskling.Companion.Shell/Deskling.Companion.Shell.csproj" />
    <ProjectReference Include="../Deskling.Windows/Deskling.Windows.csproj" />
    <InternalsVisibleTo Include="Deskling.Windows.Companion.Tests" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <!-- GDI+, for the tray glyph's HICON. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
  </ItemGroup>
</Project>
