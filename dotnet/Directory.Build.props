<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- One version for every package, set by the release workflow from the tag (vX.Y.Z). -->
    <LachingVersion Condition="'$(LachingVersion)' == ''">0.13.0</LachingVersion>
    <Version>$(LachingVersion)</Version>
    <Authors>Vlad Mihalachi</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/vmihalachi/laching</PackageProjectUrl>
    <RepositoryUrl>https://github.com/vmihalachi/laching</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>tray;menubar;desktop;idle;busy;scheduler;winui</PackageTags>
  </PropertyGroup>
</Project>
