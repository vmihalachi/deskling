<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <PackageId>Deskling.Windows</PackageId>
    <Description>Windows services for little tray apps: a raw Shell_NotifyIcon tray icon host with a native menu, RegisterHotKey, GetLastInputInfo idle time, call and full-screen detection without opening a device, power source, output mute, appearance and session-lock signals, StartupTask, LocalSettings store, WAV player, app notifications, single instance, .resw lookup, Microsoft Store purchases (StoreContext).</Description>
    <!-- Restores and compiles on Linux and macOS too (no XAML), so an IDE there can work on it. The Windows App SDK's
         PRI step (MakePri.exe) runs only on Windows, so CI builds this project on windows-latest (dotnet.yml). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Fixed buffers in Win32 structs and the source-generated COM interfaces (Core Audio). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <ProjectReference Include="../Deskling.Core/Deskling.Core.csproj" />
    <!-- DispatcherQueue (tray menu commands), AppNotificationManager, AppInstance (single instance), MRT Core (.resw lookup), MarkupExtension. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>
</Project>
