<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Consumers publish with Native AOT; this runs the trim and AOT analyzers here too. -->
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <PackageId>Deskling.Companion.Shell</PackageId>
    <Description>The platform-free half of a desk-companion app's shell, the C# twin of the Swift DesklingCompanionUI's logic: speech in parts with recorded voices, the delivery performer, the signal hub, the desktop layout and placement. Written against small interfaces (speaker, chime, timers, signal sources) that Deskling.Windows.Companion implements, so it is tested on any OS. No OS or UI dependencies.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Deskling.Core\Deskling.Core.csproj" />
    <ProjectReference Include="..\Deskling.Companion\Deskling.Companion.csproj" />
    <InternalsVisibleTo Include="Deskling.Companion.Shell.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
