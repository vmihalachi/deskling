<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Deskling.Testing" />
    <Using Include="Deskling.Testing.Conformance" />
    <Using Include="Deskling.Testing.Fixtures" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Deskling.Companion.Shell\Deskling.Companion.Shell.csproj" />
    <ProjectReference Include="..\Deskling.Testing\Deskling.Testing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Swift shell tests' recorded voices (Italian shipping, English testing) and sunnysays' sunflower: the same files both sides test against. -->
    <None Include="..\..\Tests\DesklingShellTests\Resources\Voice\**\*" Link="Resources\Voice\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Tests\DesklingCompanionTests\Resources\sunflower.json" Link="Resources\sunflower.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
