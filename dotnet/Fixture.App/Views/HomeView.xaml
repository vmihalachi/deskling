<UserControl
    x:Class="FixtureApp.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dv="using:Deskling.Windows.Companion.Views"
    xmlns:views="using:FixtureApp.Views">
    <ScrollViewer>
        <StackPanel Margin="{x:Bind dv:WindowInset.Content}" Spacing="16">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Deskling fixture" />
                    <!-- The tray glyph in the window, talking while a line is heard (the apps' Home pictures the tray with it). -->
                    <dv:GlyphWave
                        VerticalAlignment="Center"
                        Active="{x:Bind Model.IsVoicing, Mode=OneWay}"
                        Character="{x:Bind Model.GlyphCharacter}"
                        GlyphSize="24" />
                </StackPanel>
                <dv:StatusPill Text="{x:Bind Model.StatusLine, Mode=OneWay}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Model.ClockLine, Mode=OneWay}" />
            </StackPanel>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                <dv:CharacterCanvas
                    x:Name="Figure"
                    Width="120"
                    Height="120"
                    AccessibilityLabel="The fixture"
                    Character="{x:Bind Model.GlyphCharacter}"
                    Line="{x:Bind Model.Bubble, Mode=OneWay}"
                    Mood="{x:Bind Model.Mood, Mode=OneWay}"
                    Talking="{x:Bind Model.IsVoicing, Mode=OneWay}" />
                <dv:SpeechBubble
                    x:Name="Speech"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    RoomForDial="True"
                    Text="{x:Bind Model.Bubble, Mode=OneWay}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    Click="{x:Bind Model.MuteBubbleLine}"
                    Content="Don't say that again"
                    IsEnabled="{x:Bind views:Show.Has(Model.BubblePhraseId), Mode=OneWay}" />
                <Button
                    Click="{x:Bind Model.UndoMute}"
                    Content="Undo"
                    Visibility="{x:Bind views:Show.WhenSet(Model.JustMuted), Mode=OneWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="{x:Bind Model.SayNow}" Content="Say something" Style="{StaticResource AccentButtonStyle}" />
                <Button
                    Click="{x:Bind Model.ShushForAnHour}"
                    Content="Shh for an hour"
                    Visibility="{x:Bind views:Show.Unless(Model.IsShushed), Mode=OneWay}" />
                <Button
                    Click="{x:Bind Model.Wake}"
                    Content="Wake up"
                    Visibility="{x:Bind views:Show.When(Model.IsShushed), Mode=OneWay}" />
                <Button Click="{x:Bind Model.OpenSettings}" Content="Settings" />
            </StackPanel>
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="For the hand checks" />
            <StackPanel Spacing="4">
                <Button Click="{x:Bind Model.ToggleDesktop}" Content="On the desktop, or off" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="The character stands by the taskbar: click it, drag it, right-click it, Ctrl+wheel over it. Clicks pass through around it."
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="4">
                <Button Click="{x:Bind Model.OpenPanel}" Content="Open the panel" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="As a click on the tray icon does; it opens by the icon, or by the ^ while the icon is in the overflow."
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="4">
                <Button Click="{x:Bind Model.SayLongLine}" Content="Say a long line" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Then start a call (opening the Camera app will do): the line stops."
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="{x:Bind Model.MakeLineDue}" Content="Next line now" />
                    <Button Click="{x:Bind Model.MakeLineDueSoon}" Content="Next line in 10 s" />
                </StackPanel>
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Skips the clock to the next line. Go full screen within the 10 s: the line waits until 30 s after you leave it."
                    TextWrapping="Wrap" />
            </StackPanel>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <dv:CharacterCanvas
                    x:Name="RasterFigure"
                    Width="72"
                    Height="72"
                    AccessibilityLabel="The raster fixture"
                    Character="{x:Bind Model.RasterCharacter}"
                    Mood="{x:Bind Model.Mood, Mode=OneWay}"
                    Talking="{x:Bind Model.IsVoicing, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="The raster fixture, from its PNGs: it sways, blinks and talks with the other."
                    TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                    <Button Click="{x:Bind Model.Quit}" Content="Quit" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="As the tray menu's Quit. A notification left behind starts the app again, without Home."
                        TextWrapping="Wrap" />
                </StackPanel>
                <dv:Pointer
                    Grid.Column="1"
                    Width="64"
                    Height="48"
                    VerticalAlignment="Bottom" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
