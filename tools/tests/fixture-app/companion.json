{
  "$comment": "A minimal companion app for tools/tests: English source, Italian and German, a line, a joke, an Italian-only line and a tune.",
  "name": "fixture",
  "displayName": "Fixture",
  "character": "Fixy",
  "bundleId": "app.fixture",
  "domain": "fixture.example",
  "devBundleId": "app.fixture.dev",
  "deskling": { "tag": "v0.5.0", "path": "deskling" },
  "mac": {
    "dir": "macos",
    "project": "Fixture.xcodeproj",
    "projectSpec": "project.yml",
    "scheme": "Fixture",
    "app": "Fixture",
    "core": "FixtureCore",
    "coreModule": "FixtureCore",
    "tests": "FixtureTests",
    "devAppName": "Fixture Dev",
    "screenshotEnv": "DESKLING_SCREENSHOT_MODE",
    "derivedData": "macos/build/dd.noindex"
  },
  "windows": {
    "dir": "windows", "core": "Fixture.Core", "app": "Fixture.App", "sln": "Fixture.sln", "strings": "windows/Fixture.App/Strings",
    "appTests": "Fixture.App.Tests",
    "assets": { "source": "macos/Fixture/Resources/AppIcon.png", "devSource": "macos/Fixture/Resources/AppIcon-Dev.png", "out": "windows/Fixture.App/Assets" },
    "screenshots": "screenshots/windows"
  },
  "languages": { "source": "en", "all": ["en", "it", "de"] },
  "l10n": {
    "catalog": "macos/Fixture/Resources/Localizable.xcstrings",
    "plist": null,
    "landing": null,
    "glossaryKeys": ["Say something"],
    "keepNames": ["Fixy"],
    "rulesFile": "macos/scripts/l10n-rules.md",
    "pluralCategories": {},
    "linuxPo": null,
    "phraseComment": "{character} says this aloud ({tags}). Flavor {flavorNote}.{part}",
    "flavorNotes": { "a": "a: the first flavor", "b": "b: the second flavor" }
  },
  "conformance": { "dir": "conformance", "writeFlag": "FIXTURE_WRITE_CONFORMANCE", "corePackagePath": "macos/FixtureCore" },
  "voice": {
    "dir": "voices",
    "config": "macos/scripts/voice-config.json",
    "voices": ["clown"],
    "defaultVoice": "clown",
    "keychainService": "fixture-elevenlabs",
    "reviewTitle": "Fixy's voice",
    "siteCopyright": "© Fixture",
    "extraClips": { "ui-test-voice": "Hello. This is how I sound." },
    "required": ["ui-test-voice"]
  },
  "sounds": { "out": "macos/Fixture/Resources/Sounds", "recipes": "macos/scripts/sounds.py" },
  "fonts": null,
  "screenshots": { "out": "screenshots/macos", "shots": ["panel", "home"], "store": null },
  "landing": null,
  "store": {
    "dir": "store-listing",
    "apple": {
      "appId": "1234567890", "copyright": "2026 Fixture", "baseTerritory": "ITA",
      "locales": { "en": "en-US", "it": "it", "de": "de-DE" }, "extraLocales": { "en": ["en-GB", "en-CA", "en-AU"] },
      "iaps": {
        "app.fixture.supporter": {
          "reference": "Supporter", "type": "NON_CONSUMABLE", "familySharing": true, "price": "1.99",
          "name": "apple.iap.supporter.name", "description": "apple.iap.supporter.description",
          "reviewNote": "A thank-you; it unlocks nothing.", "reviewShot": "support-light.png"
        }
      },
      "review": { "shots": "screenshots/macos", "size": [1440, 900], "background": "FFF8E7" }
    },
    "microsoft": { "screenshotCount": 2, "publisher": "Fixture Studio" }
  },
  "hooks": { "guardedExtra": ["^design/locked\\.txt$"], "macUI": "^macos/Fixture/Views/.*\\.swift$", "windowsUI": "^windows/Fixture\\.App/" }
}
